{
  "rules": {
    ".read": false,
    ".write": false,
    "posts": {
      ".read": "(auth != null && (auth.token.admin === true || auth.token.email === 'batikanceylan06@gmail.com' || auth.token.email === 'kocasezinkoca@icloud.com')) || (query.orderByChild === 'status' && query.equalTo === 'published') || (query.orderByChild === 'publishAt' && query.startAt === 1 && query.endAt === (now - (now % 60000)))",
      ".write": "auth != null && (auth.token.admin === true || auth.token.email === 'batikanceylan06@gmail.com' || auth.token.email === 'kocasezinkoca@icloud.com')",
      ".indexOn": ["status", "publishAt"],
      "$postId": {
        ".read": "data.child('status').val() === 'published' || (data.child('status').val() === 'scheduled' && data.child('publishAt').isNumber() && data.child('publishAt').val() <= now) || (auth != null && (auth.token.admin === true || auth.token.email === 'batikanceylan06@gmail.com' || auth.token.email === 'kocasezinkoca@icloud.com'))",
        ".validate": "newData.hasChildren(['title', 'slug', 'content', 'type', 'status', 'date', 'createdAt', 'updatedAt']) && ((newData.child('status').val() === 'scheduled' && newData.child('publishAt').isNumber() && newData.child('publishAt').val() > 0) || ((newData.child('status').val() === 'published' || newData.child('status').val() === 'draft') && !newData.hasChild('publishAt')))",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
        },
        "slug": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 180 && newData.val().matches(/^[a-z0-9]+(-[a-z0-9]+)*$/)"
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100000"
        },
        "type": {
          ".validate": "newData.isString() && (newData.val() === 'poem' || newData.val() === 'daily')"
        },
        "category": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'published' || newData.val() === 'draft' || newData.val() === 'scheduled')"
        },
        "publishAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "series": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "authorNote": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "featured": {
          ".validate": "newData.isBoolean()"
        },
        "excerpt": {
          ".validate": "newData.isString() && newData.val().length <= 220"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^(19|20)[0-9][0-9]-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
